package-as: MelloUI

# The release notes are the newest section of CHANGELOG.md, written to this
# file by the Release workflow just before packaging (not from the git log).
manual-changelog: CHANGELOG-release.md

# Everything the client does not need stays out of the addon zip.
ignore:
  - Tools
  - docs
  - .github
  - .gitignore
  - .pkgmeta
  - .luacheckrc
  - CHANGELOG.md

enable-nolib-creation: no
